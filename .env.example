# Postgres. Prisma reads this for both the app and migrations.
DATABASE_URL="postgresql://user:password@localhost:5432/snapwrap?schema=public"

# --- Image generation -------------------------------------------------------
# Which adapter to use: "openai", "replicate", or "local".
# "local" draws the in-house canvas designs instead of calling a model, so the
# app runs with no credentials at all. Never expose these to the browser.
IMAGE_PROVIDER="local"
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="gpt-image-1"
REPLICATE_API_TOKEN=""
REPLICATE_IMAGE_MODEL=""

# --- Storage ----------------------------------------------------------------
# "s3" for any S3-compatible bucket, "local" to write under .storage/ in dev.
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Set when the bucket is served from a CDN or custom domain.
S3_PUBLIC_URL=""

# --- Limits -----------------------------------------------------------------
# Generations allowed per session per hour.
GENERATION_RATE_LIMIT="12"
